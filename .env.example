
# Public URL that endpoints post to (the value given to the Syncro script).
APP_URL=http://zabbcomm.example.com:8000

# Token the script sends to verify with the application, needs to be the same as the powershell script
API_TOKEN=

# Zabbix server or proxy that accepts trapper data
ZABBIX_SERVER=zabbix.example.com

# IP address or CIDR of the reverse proxy, as this container sees it. A proxy on
# the Docker host usually appears as the network's gateway (e.g. 172.18.0.1).
# If this is wrong, every device seems to share the proxy's address and sites
# can't be told apart. Never use * if clients can reach the app directly.
FORWARDED_ALLOW_IPS: 127.0.0.1