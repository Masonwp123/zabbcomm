# Copy to .env and fill in. .env holds the API token: never commit it.
# Commented-out lines show the default; uncomment to change. Don't leave a value empty.

# ---------------------------------------------------------------- required

# Shared token the Syncro script sends. At least 16 characters. Generate one with:
#   openssl rand -hex 32
API_TOKEN=

# Zabbix server or proxy that accepts trapper data.
# Use host.docker.internal if it runs on the same machine as this container.
ZABBIX_SERVER=zabbix.example.com

# ---------------------------------------------------------------- Zabbix

# ZABBIX_PORT=10051

# Name of the Zabbix host that has the zabbcomm template linked.
# ZABBIX_HOST=zabbcomm

# true = log the values instead of sending them (for testing).
# ZABBIX_DRY_RUN=false

# ---------------------------------------------------------------- network

# Where Docker publishes the app on the host. The default only accepts local
# connections, which suits a reverse proxy on the same machine. The app serves plain
# HTTP, so put a TLS proxy in front before exposing it to the internet.
# PUBLISH_ADDRESS=127.0.0.1
# PUBLISH_PORT=8000

# IP address or CIDR of your reverse proxy, as seen from inside the container (a proxy
# on the Docker host appears as the compose network's gateway, e.g. 172.18.0.1).
# Without this, every device appears to come from the proxy and sites can't be told apart.
# Never set it to * if clients can reach the app directly.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Public URL that endpoints post to (the value given to the Syncro script).
# Not used by the app itself.
# APP_URL=https://zabbcomm.example.com

# ---------------------------------------------------------------- timing (seconds)

# How often Syncro runs the check-in script.
# CHECKIN_INTERVAL=900
# Silence after which a device counts as offline. Keep at least 2x CHECKIN_INTERVAL.
# DEVICE_TIMEOUT=2100
# How often status is evaluated and sent to Zabbix.
# EVAL_INTERVAL=60
# How often the full discovery data is resent.
# DISCOVERY_INTERVAL=3600
# Silence after which a device is removed entirely (7 days).
# DEVICE_FORGET_AFTER=604800

# ---------------------------------------------------------------- sites and limits

# Devices that must share a public IP before it counts as a site.
# SITE_MIN_DEVICES=2
# SITE_IPV6_PREFIX=64
# MAX_ORGS=500
# MAX_DEVICES_PER_ORG=1000

# DEBUG, INFO, WARNING or ERROR
# LOG_LEVEL=INFO

# ---------------------------------------------------------------- without Docker only

# compose.yaml fixes these three inside the container. They apply when running
# `uv run --env-file .env zabbcomm` directly.
# HOST=0.0.0.0
# PORT=8000
# DATA_DIR=./.devdata
